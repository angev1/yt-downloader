/* ============================================================
   YouTube Downloader — Modern Clean Theme
   ============================================================ */

* {
    font-family: "Segoe UI", "SF Pro Display", sans-serif;
    font-size: 13px;
    color: #EDEDED;
    outline: none;
}

QMainWindow {
    background-color: #141414;
}

QWidget#container {
    background-color: #141414;
}

QLabel#title {
    font-size: 18px;
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: 0.3px;
    padding-bottom: 4px;
}

QLineEdit {
    background-color: #1E1E1E;
    border: 1.5px solid #2A2A2A;
    border-radius: 10px;
    padding: 0px 16px;
    color: #EDEDED;
    font-size: 13px;
    selection-background-color: #FF4444;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 1.5px solid #FF4444;
    background-color: #222222;
}

QLineEdit:hover {
    border: 1.5px solid #383838;
}

QPushButton#browseButton {
    background-color: #252525;
    border: 1.5px solid #2A2A2A;
    border-radius: 10px;
    color: #AAAAAA;
    font-size: 13px;
    font-weight: 500;
    padding: 0px 12px;
}

QPushButton#browseButton:hover {
    background-color: #2E2E2E;
    border-color: #3A3A3A;
    color: #EDEDED;
}

QPushButton#browseButton:pressed {
    background-color: #1E1E1E;
}

QPushButton#downloadButton {
    background-color: #FF4444;
    border: none;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.4px;
    padding: 0px 20px;
}

QPushButton#downloadButton:hover {
    background-color: #FF5C5C;
}

QPushButton#downloadButton:pressed {
    background-color: #E03333;
}

QPushButton#downloadButton:disabled {
    background-color: #2A2A2A;
    color: #555555;
}

QComboBox {
    background-color: #1E1E1E;
    border: 1.5px solid #2A2A2A;
    border-radius: 10px;
    padding: 0px 14px;
    color: #EDEDED;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #383838;
    background-color: #222222;
}

QComboBox:focus {
    border-color: #FF4444;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #888888;
    width: 0;
    height: 0;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 8px;
    color: #EDEDED;
    selection-background-color: #FF4444;
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 6px;
    min-height: 28px;
}

QProgressBar#progressBar {
    background-color: #1E1E1E;
    border: none;
    border-radius: 3px;
}

QProgressBar#progressBar::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #FF4444,
        stop: 1 #FF7070
    );
    border-radius: 3px;
}

QLabel#statusLabel {
    color: #666666;
    font-size: 12px;
    padding: 0px 2px;
}

QScrollBar:vertical {
    background: #141414;
    width: 6px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #303030;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #FF4444;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QToolTip {
    background-color: #252525;
    color: #EDEDED;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
